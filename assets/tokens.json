{
  "name": "premium-liquid-glass default tokens",
  "notes": "Starting values. Re-run scripts/contrast_check.py --tokens after changing anything. Glass fills are tinted with the surface colour (not pure white) so text stays legible over bright content.",
  "modes": {
    "dark": {
      "text": "#FFFFFF",
      "textSecondary": "#FFFFFF@0.64",
      "background": "#0A0E1A",
      "surface": "#131A2B",
      "border": "#FFFFFF@0.08",
      "tiers": {
        "thin": {
          "fill": "#0F1526@0.55",
          "blurDp": 16,
          "minContrast": 3.0,
          "use": "icon-only or large-label controls"
        },
        "regular": {
          "fill": "#0F1526@0.66",
          "blurDp": 24,
          "minContrast": 4.5,
          "use": "nav pill, top bar, search field, FAB, toasts"
        },
        "thick": {
          "fill": "#0F1526@0.78",
          "blurDp": 32,
          "minContrast": 4.5,
          "use": "sheets, menus, dialogs"
        }
      },
      "solidFallback": {
        "thin": "#161D30",
        "regular": "#161D30",
        "thick": "#1B2338"
      }
    },
    "light": {
      "text": "#0A0E1A",
      "textSecondary": "#0A0E1A@0.62",
      "background": "#F5F6FA",
      "surface": "#FFFFFF",
      "border": "#0A0E1A@0.06",
      "tiers": {
        "thin": {
          "fill": "#FFFFFF@0.55",
          "blurDp": 16,
          "minContrast": 3.0,
          "use": "icon-only or large-label controls"
        },
        "regular": {
          "fill": "#FFFFFF@0.70",
          "blurDp": 24,
          "minContrast": 4.5,
          "use": "nav pill, top bar, search field, FAB, toasts"
        },
        "thick": {
          "fill": "#FFFFFF@0.82",
          "blurDp": 32,
          "minContrast": 4.5,
          "use": "sheets, menus, dialogs"
        }
      },
      "solidFallback": {
        "thin": "#F1F3F9",
        "regular": "#F1F3F9",
        "thick": "#FFFFFF"
      }
    }
  },
  "accent": {
    "indigo": "#5B6CFF",
    "keep": "#2BD48A",
    "delete": "#FF5C6C",
    "remind": "#FFB84D",
    "sensitive": "#8B7CFF"
  },
  "radius": {
    "chip": 999,
    "control": 16,
    "card": 24,
    "navPill": 28,
    "sheet": 32
  },
  "spacingDp": [
    4,
    8,
    12,
    16,
    20,
    24,
    32
  ],
  "type": {
    "font": "Inter",
    "title": {
      "size": 34,
      "line": 40,
      "weight": 600
    },
    "headline": {
      "size": 20,
      "line": 28,
      "weight": 600
    },
    "body": {
      "size": 16,
      "line": 24,
      "weight": 400
    },
    "caption": {
      "size": 13,
      "line": 18,
      "weight": 500
    }
  },
  "edge": {
    "hairlineDp": 1,
    "highlightAlphaDark": 0.2,
    "highlightAlphaLight": 0.6
  },
  "shadow": {
    "dy": 10,
    "blur": 28,
    "alpha": 0.28
  },
  "motion": {
    "fastMs": 150,
    "baseMs": 250,
    "slowMs": 350
  }
}